{
  "name": "tripbanban",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @tripbanban/web",
    "mobile": "npm run start -w @tripbanban/mobile",
    "android": "npm run android -w @tripbanban/mobile",
    "build": "npm run build -w @tripbanban/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor:mobile": "npm run doctor -w @tripbanban/mobile"
  }
}
